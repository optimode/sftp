# ===========================================================================
#  .env.dev.example -- DEVELOPER configuration
#
#  Copy to .env and fill it in:
#      cp .env.dev.example .env
#      docker compose -f docker-compose.dev.yml up -d --build
# ===========================================================================

# --- User / isolation ------------------------------------------------------
# Name of the primary SFTP user to create
SFTP_USER=sftpuser

# UID / GID of the user (inside the container)
SFTP_UID=1000
SFTP_GID=1000

# Home directory the user logs into and can write to.
# The chroot is its PARENT directory. Default: /sftp/<user>/data
SFTP_HOME=/sftp/sftpuser/data

# Base directory for chroots (extra users: <base>/<user>/...)
SFTP_CHROOT_BASE=/sftp

# --- Authentication --------------------------------------------------------
# Provide a public key AND/OR a password.
# Public key (recommended). Paste the contents of id_ed25519.pub here:
SSH_PUBLIC_KEY=

# Password (if empty and a key is given, password login is disabled):
SFTP_PASSWORD=

# --- Network ---------------------------------------------------------------
# SSH port inside the container (docker compose maps it to the host)
SFTP_PORT=22

# Host port you reach the server on
SFTP_HOST_PORT=2222

# --- Logging ---------------------------------------------------------------
# QUIET | ERROR | INFO | VERBOSE | DEBUG
SFTP_LOG_LEVEL=INFO

# Timezone for log timestamps (tzdata is installed in the image)
TZ=Europe/Budapest

# How many daily log files to keep, in days (0 = never delete)
SFTP_LOG_RETENTION_DAYS=14
