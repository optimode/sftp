# Local environment files (may contain secrets)
.env
.env.dev

# Runtime data and logs
data/
logs/

# Real user configuration (keep only the *.example templates tracked)
etc-sftp/users.conf
etc-sftp/authorized_keys/*
etc-sftp/passwords/*
!etc-sftp/authorized_keys/.gitkeep
!etc-sftp/passwords/.gitkeep

# Editor / OS noise
*.swp
.DS_Store
