# ===========================================================================
#  .env.example -- PRODUCTION configuration (multiuser)
#
#  Copy to .env and fill it in:
#      cp .env.example .env
#      cp etc-sftp/users.conf.example etc-sftp/users.conf   # then edit
#      docker compose up -d
#
#  Users are defined in ./etc-sftp/users.conf (NOT here). This file only
#  holds deployment-wide settings.
# ===========================================================================

# --- Image -----------------------------------------------------------------
# Published image tag (e.g. latest, 1, 1.0, 1.0.0)
SFTP_IMAGE_TAG=latest

# --- Chroot base / default ids --------------------------------------------
# Base directory for chroots; users live under <base>/<name>/data
SFTP_CHROOT_BASE=/sftp

# Default UID/GID for users.conf entries that omit them
SFTP_UID=1000
SFTP_GID=1000

# --- Network ---------------------------------------------------------------
# SSH port inside the container (docker compose maps it to the host)
SFTP_PORT=22

# Host port you reach the server on
SFTP_HOST_PORT=2222

# Listening interface inside the container
SFTP_LISTEN=0.0.0.0

# --- Logging ---------------------------------------------------------------
# QUIET | ERROR | INFO | VERBOSE | DEBUG
SFTP_LOG_LEVEL=INFO

# Timezone for log timestamps (tzdata is installed in the image)
TZ=UTC

# How many daily log files to keep, in days (0 = never delete)
SFTP_LOG_RETENTION_DAYS=30

# --- Healthcheck tuning (optional; the `test` is inherited from the image) --
SFTP_HC_INTERVAL=30s
SFTP_HC_TIMEOUT=5s
SFTP_HC_RETRIES=3
SFTP_HC_START_PERIOD=10s
